# App
APP_ENV=local
PYTHONPATH=/app

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=retentionops
MLFLOW_BACKEND_STORE_URI=sqlite:////var/lib/mlflow/mlflow.db
MLFLOW_ARTIFACT_ROOT=file:///var/lib/mlflow/mlruns

# Model Registry
UPLIFT_MODEL_NAME=uplift_model
UPLIFT_MODEL_ALIAS=champion

# PostgreSQL
POSTGRES_USER=retentionops
POSTGRES_PASSWORD=retentionops
POSTGRES_DB=retentionops
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://retentionops:retentionops@postgres:5432/retentionops

# API
API_HOST=0.0.0.0
API_PORT=8000
ENABLE_DECISION_LOGGING=true
DEMO_LOCAL_HISTORY=true

# Control Center
WEB_PUBLIC_URL=http://localhost:3000
OPS_ADMIN_TOKEN=demo-admin
OPS_JOB_TIMEOUT_SECONDS=3600
POLICY_STORE_ENABLED=true
DRIFT_SIMULATION_BASELINE_PATH=data/processed/test.parquet
DRIFT_SIMULATION_ARTIFACT_ROOT=/var/lib/retentionops/simulations
DRIFT_SIMULATION_RETENTION_SECONDS=3600
DRIFT_SIMULATION_MAX_FILE_BYTES=52428800
DRIFT_SIMULATION_MAX_CSV_BYTES=104857600
DRIFT_SIMULATION_PREDICTION_BATCH_SIZE=10000
DRIFT_SIMULATION_MAX_PREDICTION_ROWS=100000
DRIFT_SIMULATION_MAX_PREDICTION_FILE_BYTES=104857600
RETENTIONOPS_REPORT_ROOT=/var/lib/retentionops/reports
API_PUBLIC_URL=http://localhost:8000
MLFLOW_PUBLIC_URL=http://localhost:5000
PROMETHEUS_PUBLIC_URL=http://localhost:9090
GRAFANA_PUBLIC_URL=http://localhost:3001

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
